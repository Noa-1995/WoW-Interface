<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="AddonList.lua"/>

    <!-- ═══════════════════════════════════════════════════════
         Template para cada fila de addon
         ═══════════════════════════════════════════════════════ -->
    <Button name="AddonListEntryTemplate" virtual="true">
        <Size x="590" y="16"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentHighlight" parentKey="Highlight" hidden="true" file="Interface\COMMON\Search.blp">
                    <Size x="330" y="16"/>
                    <Anchors>
                        <Anchor point="LEFT" x="28" y="0"/>
                    </Anchors>
                    <TexCoords left="0.529296875" right="0.737500000" top="0.226562500" bottom="0.456562500"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" parentKey="Title"
                            inherits="GameFontNormalSmall"
                            justifyH="LEFT" nonspacewrap="true">
                    <Size x="310" y="14"/>
                    <Anchors>
                        <Anchor point="LEFT" x="28" y="0"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentStatus" parentKey="Status"
                            inherits="GameFontNormalSmall"
                            justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="CENTER" x="30" y="0"/>
                    </Anchors>
                    <Color r="0.59" g="0.26" b="0.26"/>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <CheckButton name="$parentStatusCheckBox" parentKey="StatusCheckBox"
                         inherits="OptionsCheckButtonTemplate">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" x="4" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        AddonList_Enable(self:GetParent():GetID(), self:GetChecked())
                        if self:GetChecked() then
                            PlaySound("igMainMenuOptionCheckBoxOn")
                        else
                            PlaySound("igMainMenuOptionCheckBoxOff")
                        end
                    </OnClick>
                </Scripts>
            </CheckButton>
        </Frames>
        <Scripts>
            <OnClick>
                AddonList_SelectAddon(self:GetID())
            </OnClick>
        </Scripts>
    </Button>

    <!-- ═══════════════════════════════════════════════════════
         Frame principal
         ═══════════════════════════════════════════════════════ -->
    <Frame name="AddonList" inherits="PortraitFrameTemplateSimple_Noa_NineSlice" toplevel="true" movable="true" enableMouse="true" enableKeyboard="true" frameStrata="DIALOG" hidden="true" parent="UIParent">

        <Size x="900" y="600"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Frames>
            <Frame name="$parentCustomTitleFrame" frameLevel="100">
                <Size x="660" y="40"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP" x="0" y="-3"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString name="$parentTitleText"
                                    inherits="GameFontNormalLarge"
                                    text="ADDON_LIST_TITLE">
                            <Anchors>
                                <Anchor point="TOP"/>
                            </Anchors>
                            <Color r="1" g="0.82" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- ──────────────────────────────────────────────
                 Área de scroll y botones
                 ────────────────────────────────────────────── -->
            <Frame name="AddonListScrollArea">
                <Size x="400" y="500"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-60"/>
                </Anchors>

                <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border"
                          tile="true">
                    <EdgeSize val="16"/>
                    <TileSize val="16"/>
                    <BackgroundInsets>
                        <AbsInset left="5" right="5" top="5" bottom="5"/>
                    </BackgroundInsets>
                </Backdrop>

                <Frames>
                    <Button name="AddonListEntry1"  inherits="AddonListEntryTemplate" id="1">
                        <Anchors><Anchor point="TOPLEFT" x="8" y="-6"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry2"  inherits="AddonListEntryTemplate" id="2">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry1"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry3"  inherits="AddonListEntryTemplate" id="3">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry2"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry4"  inherits="AddonListEntryTemplate" id="4">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry3"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry5"  inherits="AddonListEntryTemplate" id="5">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry4"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry6"  inherits="AddonListEntryTemplate" id="6">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry5"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry7"  inherits="AddonListEntryTemplate" id="7">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry6"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry8"  inherits="AddonListEntryTemplate" id="8">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry7"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry9"  inherits="AddonListEntryTemplate" id="9">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry8"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry10" inherits="AddonListEntryTemplate" id="10">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry9"  relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry11" inherits="AddonListEntryTemplate" id="11">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry10" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry12" inherits="AddonListEntryTemplate" id="12">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry11" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry13" inherits="AddonListEntryTemplate" id="13">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry12" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry14" inherits="AddonListEntryTemplate" id="14">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry13" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry15" inherits="AddonListEntryTemplate" id="15">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry14" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>
                    <Button name="AddonListEntry16" inherits="AddonListEntryTemplate" id="16">
                        <Anchors><Anchor point="TOP" relativeTo="AddonListEntry15" relativePoint="BOTTOM" x="0" y="-2"/></Anchors>
                    </Button>

                    <ScrollFrame name="AddonListScrollFrame" inherits="FauxScrollFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT"     relativeTo="AddonListScrollArea" x="10"   y="-7"/>
                            <Anchor point="BOTTOMRIGHT" relativeTo="AddonListScrollArea" x="-30" y="7"/>
                        </Anchors>
                        <Scripts>
                            <OnVerticalScroll>
                                AddonListScrollFrame_OnVerticalScroll(self, offset)
                            </OnVerticalScroll>
                        </Scripts>
                    </ScrollFrame>
                </Frames>
            </Frame>

            <!-- ═══════════════════════════════════════════════════════
                 Panel de información lateral
                 ═══════════════════════════════════════════════════════ -->
            <Frame name="AddonInfoPanel">
                <Size x="450" y="500"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AddonListScrollArea" relativePoint="TOPRIGHT" x="30" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeTo="AddonListScrollArea" relativePoint="BOTTOMRIGHT" x="30" y="0"/>
                </Anchors>
                
                <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border"
                          tile="true">
                    <BackgroundInsets>
                        <AbsInset left="5" right="5" top="5" bottom="5"/>
                    </BackgroundInsets>
                    <TileSize><AbsValue val="16"/></TileSize>
                    <EdgeSize><AbsValue val="16"/></EdgeSize>
                </Backdrop>
                
                <Layers>
                    <Layer level="ARTWORK">
                        <!-- Título del panel -->
                        <FontString name="$parentTitle" inherits="GameFontNormalLarge" justifyH="CENTER">
                            <Size x="240" y="20"/>
                            <Anchors>
                                <Anchor point="TOP" x="0" y="-15"/>
                            </Anchors>
                            <Color r="1" g="0.82" b="0"/>
                            <Text value="ADDON_LIST_INFO"/>
                        </FontString>
                        
                        <!-- Línea separadora -->
                        <FontString name="$parentSeparator" inherits="GameFontNormal" justifyH="CENTER">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentTitle" relativePoint="BOTTOM" x="0" y="-5"/>
                            </Anchors>
                            <Color r="0.5" g="0.5" b="0.5"/>
                            <Text value="─────────────────"/>
                        </FontString>
                        
                        <!-- Nombre del addon -->
                        <FontString name="$parentAddonName" inherits="GameFontNormalLarge" justifyH="LEFT">
                            <Size x="240" y="20"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentSeparator" relativePoint="BOTTOM" x="0" y="-10"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                            <Color r="1" g="1" b="1"/>
                        </FontString>
                        
                        <!-- Estado -->
                        <FontString name="$parentStatus" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentAddonName" relativePoint="BOTTOM" x="0" y="-5"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                        </FontString>
                        
                        <!-- Autor -->
                        <FontString name="$parentAuthor" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentStatus" relativePoint="BOTTOM" x="0" y="-5"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.8"/>
                        </FontString>
                        
                        <!-- Versión -->
                        <FontString name="$parentVersion" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentAuthor" relativePoint="BOTTOM" x="0" y="-5"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.8"/>
                        </FontString>
                        
                        <!-- Separador antes de descripción -->
                        <FontString name="$parentSep2" inherits="GameFontNormal" justifyH="CENTER">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentVersion" relativePoint="BOTTOM" x="0" y="-5"/>
                            </Anchors>
                            <Color r="0.5" g="0.5" b="0.5"/>
                            <Text value="─────────────────"/>
                        </FontString>
                        
                        <!-- Título de descripción -->
                        <FontString name="$parentNotesTitle" inherits="GameFontNormal" justifyH="LEFT">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentSep2" relativePoint="BOTTOM" x="0" y="-5"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                            <Color r="1" g="1" b="1"/>
                            <Text value="ADDON_LIST_DESCRIPTION"/>
                        </FontString>
                        
                        <!-- Descripción (con wrap) -->
                        <FontString name="$parentNotes" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="240" y="0"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentNotesTitle" relativePoint="BOTTOM" x="0" y="-2"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                                <Anchor point="RIGHT" x="-15" y="0"/>
                            </Anchors>
                            <Color r="0.9" g="0.9" b="0.9"/>
                        </FontString>
                        
                        <!-- Título de dependencias -->
                        <FontString name="$parentDepsTitle" inherits="GameFontNormal" justifyH="LEFT">
                            <Size x="240" y="16"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentNotes" relativePoint="BOTTOM" x="0" y="-10"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                            </Anchors>
                            <Color r="1" g="1" b="1"/>
                            <Text value="ADDON_LIST_DEPENDENCIES"/>
                        </FontString>
                        
                        <!-- Dependencias -->
                        <FontString name="$parentDeps" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="240" y="0"/>
                            <Anchors>
                                <Anchor point="TOP" relativeTo="$parentDepsTitle" relativePoint="BOTTOM" x="0" y="-2"/>
                                <Anchor point="LEFT" x="15" y="0"/>
                                <Anchor point="RIGHT" x="-15" y="0"/>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.5"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- ──────────────────────────────────────────────
                 Botones inferiores
                 ────────────────────────────────────────────── -->
            <Button name="AddonListDisableAllButton" inherits="UIPanelButtonTemplate" text="DISABLE_ALL_ADDONS">
                <Size x="130" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="16" y="16"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        AddonList_DisableAll()
                        PlaySound("igMainMenuOptionCheckBoxOff")
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="AddonListEnableAllButton" inherits="UIPanelButtonTemplate" text="ENABLE_ALL_ADDONS">
                <Size x="130" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="AddonListDisableAllButton"
                            relativePoint="RIGHT" x="8" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        AddonList_EnableAll()
                        PlaySound("igMainMenuOptionCheckBoxOn")
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="AddonListReloadButton" inherits="UIPanelButtonTemplate" text="RELOADUI">
                <Size x="110" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-16" y="16"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        AddonList_DoReload()
                    </OnClick>
                </Scripts>
            </Button>

        </Frames>

        <Scripts>
            <OnLoad>
                AddonList_OnLoad(self)
            </OnLoad>
            <OnEvent>
                AddonList_OnEvent(self, event, ...)
            </OnEvent>
            <OnKeyDown>
                AddonList_OnKeyDown(key)
            </OnKeyDown>
            <OnShow>
                AddonList_OnShow()
            </OnShow>
        </Scripts>
    </Frame>
</Ui>