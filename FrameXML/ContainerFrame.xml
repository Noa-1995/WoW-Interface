	<!-- Gestor de contenedores -->
	<Frame name="ContainerFrameManager" hidden="true">
		<Scripts>
			<OnLoad function="ContainerFrameManager_OnLoad"/>
			<OnEvent function="ContainerFrameManager_OnEvent"/>
		</Scripts>
	</Frame>
	
	<!-- Template para mochila expandida -->
	<Frame name="ExpandedBackpackTemplate" inherits="PortraitFrameTemplateMinimal_Noa_NineSlice" virtual="true">
		<Size x="435" y="780"/>

	
		<Frames>
			<Button name="$parentToggleButton" parentKey="toggleButton">
				<Size x="32" y="32"/>
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-18" y="4"/>
				</Anchors>
				<NormalTexture file="Interface\Buttons\UI-Panel-SmallerButton-Up"/>
				<PushedTexture file="Interface\Buttons\UI-Panel-SmallerButton-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnLoad>
						self:RegisterForClicks("LeftButtonUp", "RightButtonUp");
					</OnLoad>
					<OnClick>
						ToggleExpandedBackpack(self:GetParent());
					</OnClick>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_LEFT");
						GameTooltip:SetText(CONTAINER_EXPAND_ENABLE, 1.0, 1.0, 1.0);
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide();
					</OnLeave>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>