    <EditBox name="TalentRetailSearchBoxTemplate" inherits="InputBoxTemplate" autoFocus="false" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <Texture name="$parentSearchIcon" file="Interface\TalentRetail\TalentRetailSearchIcon" parentKey="searchIcon">
                    <Size x="14" y="14"/>
                    <Anchors><Anchor point="LEFT" x="0" y="-2"/></Anchors>
                </Texture>
            </Layer>
        </Layers>
    </EditBox>

    <Frame name="TalentRetailInsetFrameTemplate" virtual="true">
        <Layers>
            <Layer level="BORDER">
                <Texture name="$parentTopLeftCornerInset" parentKey="TopLeftCorner" inherits="Talent-Inner-TopLeft">
                    <Anchors><Anchor point="TOPLEFT"/></Anchors>
                </Texture>
                <Texture name="$parentTopRightCornerInset" parentKey="TopRightCorner" inherits="Talent-Inner-TopRight">
                    <Anchors><Anchor point="TOPRIGHT"/></Anchors>
                </Texture>
                <Texture name="$parentBotLeftCornerInset" parentKey="BotLeftCorner" inherits="Talent-Inner-BotLeft">
                    <Anchors><Anchor point="BOTTOMLEFT"/></Anchors>
                </Texture>
                <Texture name="$parentBotRightCornerInset" parentKey="BotRightCorner" inherits="Talent-Inner-BotRight">
                    <Anchors><Anchor point="BOTTOMRIGHT"/></Anchors>
                </Texture>
                <Texture parentKey="TopBorder" inherits="_Talent-Inner-TopTile">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTopLeftCornerInset" relativePoint="TOPRIGHT"/>
                        <Anchor point="TOPRIGHT" relativeTo="$parentTopRightCornerInset" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="BottomBorder" inherits="_Talent-Inner-BotTile">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentBotLeftCornerInset" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentBotRightCornerInset" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="LeftBorder" inherits="!Talent-Inner-LeftTile">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTopLeftCornerInset" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentBotLeftCornerInset" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RightBorder" inherits="!Talent-Inner-RightTile">
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeTo="$parentTopRightCornerInset" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentBotRightCornerInset" relativePoint="TOPRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="TalentRetailButtonFrameTemplate" virtual="true" inherits="PortraitFrameTemplate_NineSlice">
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentTitleText" parentKey="TitleText" inherits="GameFontNormal" wordwrap="false">
                    <Anchors>
                        <Anchor point="TOP" y="-4"/>
                        <Anchor point="LEFT" x="60"/>
                        <Anchor point="RIGHT" x="-60"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame name="$parentInset" parentKey="Inset" useParentLevel="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-6" y="26"/>
                </Anchors>
            </Frame>
        </Frames>
    </Frame>

    <Frame name="TalentRetailLoadingSpinnerTemplate" virtual="true">
        <Size x="48" y="48"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" parentKey="Text" inherits="GameFontNormal" hidden="true">
                    <Anchors><Anchor point="TOP" relativePoint="BOTTOM"/></Anchors>
                </FontString>
                <FontString name="$parentDots" parentKey="Dots" inherits="GameFontNormal" hidden="true">
                    <Anchors><Anchor point="LEFT" relativeTo="$parentText" relativePoint="RIGHT"/></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="AnimFrame" setAllPoints="true">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture file="Interface\Buttons\UI-RotationLeft-Button-Up" setAllPoints="true"/>
                    </Layer>
                </Layers>
                <Animations>
                    <AnimationGroup parentKey="Anim" looping="REPEAT">
                        <Rotation order="1" duration="1" degrees="-360"/>
                    </AnimationGroup>
                </Animations>
            </Frame>
        </Frames>
    </Frame>

    <PlayerModel name="TalentRetailModelTemplate" virtual="true">
        <Scripts>
            <OnLoad function="Model_OnLoad"/>
            <OnUpdate function="Model_OnUpdate"/>
        </Scripts>
    </PlayerModel>

    <Frame name="TalentRetailShadowOverlayTemplate" virtual="true"/>

    <Frame name="TalentRetailGlowBoxTemplate" virtual="true">
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <BackgroundInsets><AbsInset left="5" right="5" top="5" bottom="5"/></BackgroundInsets>
            <TileSize><AbsValue val="32"/></TileSize>
            <EdgeSize><AbsValue val="16"/></EdgeSize>
        </Backdrop>
        <Scripts>
            <OnLoad>
                self:SetBackdropBorderColor(1, 0.82, 0, 1)
            </OnLoad>
        </Scripts>
    </Frame>

    <Frame name="TalentRetailHorizontalBarTemplate" virtual="true">
        <Size x="300" y="6"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture file="Interface\TalentRetail\TalentRetailFrameHorizontal" setAllPoints="true" horizTile="true">
                    <TexCoords top="0.20312500" bottom="0.27343750"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
